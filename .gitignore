* {
  box-sizing: border-box;
}

:root {
  color-scheme: light;
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  background: #f5f7fb;
  color: #192033;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(135deg, #eef4ff 0%, #f9fafc 100%);
}

button,
input,
select {
  font: inherit;
}

#root {
  min-height: 100vh;
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0 0 4px;
  color: #5d6b82;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
  font-weight: 700;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 2vw + 1rem, 3rem);
}

.budget-box {
  background: #111827;
  color: #fff;
  border-radius: 18px;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  min-width: 180px;
}

.budget-box span {
  opacity: 0.75;
  font-size: 0.8rem;
}

.budget-box strong {
  font-size: 1.4rem;
  margin-top: 6px;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.summary-card,
.panel {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
}

.summary-card {
  padding: 18px 20px;
}

.summary-card p {
  margin: 0;
  opacity: 0.7;
  font-size: 0.82rem;
}

.summary-card h2 {
  margin: 10px 0 0;
  font-size: clamp(1.8rem, 1vw + 1rem, 2.2rem);
}

.summary-card.balance {
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
}

.summary-card.income {
  background: linear-gradient(135deg, #dcfce7 0%, #f0fdf4 100%);
}

.summary-card.expense {
  background: linear-gradient(135deg, #fee2e2 0%, #fef2f2 100%);
}

.summary-card.remaining {
  background: linear-gradient(135deg, #fef3c7 0%, #fffbeb 100%);
}

.panel-grid {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr;
  gap: 24px;
  margin-bottom: 24px;
}

.panel {
  padding: 22px;
}

.panel h3 {
  margin-top: 0;
  margin-bottom: 16px;
  font-size: 1.2rem;
}

.transaction-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.transaction-form label,
.budget-editor {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #334155;
  font-weight: 600;
}

.inline-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

input,
select {
  width: 100%;
  border: 1px solid #dfe7f5;
  background: #f8fafc;
  border-radius: 12px;
  padding: 12px 14px;
  color: #0f172a;
}

button {
  border: none;
  border-radius: 12px;
  background: #3b82f6;
  color: white;
  font-weight: 700;
  padding: 12px 18px;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
  opacity: 0.97;
}

.stats-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 14px 16px;
  margin-top: 14px;
}

.stats-box p {
  margin: 0 0 6px;
  font-size: 0.8rem;
  color: #5d6b82;
}

.stats-box strong {
  font-size: 1.15rem;
}

.muted {
  background: #fff7ed;
}

.transactions-panel {
  padding-bottom: 10px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.panel-header select {
  max-width: 220px;
}

.transaction-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.transaction-list li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.transaction-list li strong {
  display: block;
}

.transaction-list li span {
  display: block;
  color: #5d6b82;
  font-size: 0.8rem;
}

.amount-remove {
  display: flex;
  align-items: center;
  gap: 12px;
}

.amount-remove button {
  background: #e2e8f0;
  color: #0f172a;
  padding: 8px 10px;
  font-size: 0.82rem;
}

.income {
  color: #15803d;
  font-weight: 700;
}

.expense {
  color: #dc2626;
  font-weight: 700;
}

.empty-state {
  justify-content: center;
  color: #475569;
  padding: 18px;
}

@media (max-width: 860px) {
  .summary-grid,
  .panel-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 640px) {
  .topbar,
  .panel-header,
  .transaction-list li,
  .amount-remove {
    flex-direction: column;
    align-items: flex-start;
  }

  .summary-grid,
  .panel-grid,
  .inline-fields {
    grid-template-columns: 1fr;
  }

  .budget-box {
    width: 100%;
  }

  .transaction-list li {
    width: 100%;
  }
}
